                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='242' h='7700' id='2141' type-v2='dashboard-object' w='18519' x='3259' y='53200'>
                  <button action='tabdoc:goto-sheet window-id=&quot;{7F926C03-E879-4B32-814F-09A5CB8F1508}&quot;' button-type='text'>
                    <button-visual-state>
                      <caption>Parameters Dashboard</caption>
                      <button-caption-font-style fontname='Tableau Bold' fontsize='12' />
                      <format attr='background-color' value='#cbebf7' />
                      <format attr='border-style' value='solid' />
                      <format attr='border-width' value='2' />
