              <calculation class='tableau' formula='{ FIXED [Calculation_4665729230336856076] :&#13;&#10;&#13;&#10;CASE [Parameters].[Parameter 6 Selector (copy)_4665729230322843654]&#13;&#10;&#13;&#10;WHEN &quot;NetBenefits_Discounted&quot; THEN IFNULL(AVG([NetBenefits_Discounted]), -99999999999999999999999999999999999)&#13;&#10;WHEN &quot;_NetBenefits_Disc - COV&quot; THEN IFNULL([Calculation_1431300292636811264],  -99999999999999999999999999999999999)&#13;&#10;&#13;&#10;WHEN &quot;BCR_Discounted&quot; THEN IFNULL(AVG([BCR_Discounted]),  -99999999999999999999999999999999999)&#13;&#10;WHEN &quot;_BCR_dis - COV&quot; THEN IFNULL([Calculation_8187544157606592512],  -99999999999999999999999999999999999)&#13;&#10;&#13;&#10;WHEN &quot;RegretAll&quot; THEN IFNULL(AVG(-[RegretAll]),  -99999999999999999999999999999999999)&#13;&#10;WHEN &quot;RegretScenario&quot; THEN IFNULL(AVG(-[RegretScenario]),  -99999999999999999999999999999999999)&#13;&#10;WHEN &quot;RegretAsset&quot; THEN IFNULL(AVG(-[RegretAsset]),  -99999999999999999999999999999999999)&#13;&#10;&#13;&#10;&#13;&#10;// NEW VALUES &#13;&#10;WHEN &quot;Benefits_Discounted&quot; THEN IFNULL(AVG([Benefits_Discounted]), -99999999999999999999999999999999999)&#13;&#10;WHEN &quot;DamBenefits_Discounted&quot; THEN IFNULL(AVG(DamBenefits_Discounted), -99999999999999999999999999999999999)&#13;&#10;WHEN &quot;RepairCleanupCostSavings_Discounted&quot; THEN IFNULL(AVG(RepairCleanupCostSavings_Discounted), -99999999999999999999999999999999999)&#13;&#10;WHEN &quot;ExpBenefits_Discounted&quot; THEN IFNULL(AVG(ExpBenefits_Discounted), -99999999999999999999999999999999999)&#13;&#10;&#13;&#10;WHEN &quot;TotalMaintenanceCosts_Discounted&quot; THEN IFNULL(AVG([TotalMaintenanceCosts_Discounted]), -99999999999999999999999999999999999)&#13;&#10;WHEN &quot;TotalResidual_Discounted&quot; THEN IFNULL(AVG([TotalResidual_Discounted]), -99999999999999999999999999999999999)&#13;&#10;&#13;&#10;END }' />
