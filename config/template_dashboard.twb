                  <formatted-text>
                    <run fontalignment='1' fontcolor='#32374b' fontname='Tableau Regular' fontsize='14' italic='true'>Top</run>
                    <run fontalignment='1' fontcolor='#32374b' fontname='Tableau Regular' fontsize='18' italic='true'>Æ </run>
                    <run bold='true' fontalignment='1' fontcolor='#32374b' fontname='Tableau Regular' fontsize='16' italic='true'><![CDATA[<[Parameters].[Top N Regret Rank (copy)_0647088221831168]>]]></run>
                    <run fontalignment='1' fontcolor='#32374b' fontname='Tableau Regular' fontsize='14' italic='true'> Ranked Resilency Projects by Benefit-Cost Ratio</run>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='14' italic='true'>[          ]</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
