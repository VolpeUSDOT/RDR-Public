                      <setting key='filters' value='[{&quot;appliedValues&quot;:[&quot;_Parameter 2 Calc&quot;,&quot;_Parameter 1 Calc&quot;],&quot;fieldName&quot;:&quot;Measure Names&quot;,&quot;filterType&quot;:&quot;categorical&quot;,&quot;isExcludeMode&quot;:false,&quot;skip&quot;:true,&quot;updateType&quot;:&quot;replace&quot;,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;dataType&quot;:&quot;number&quot;,&quot;fieldName&quot;:&quot;DamageDuration&quot;,&quot;filterType&quot;:&quot;range&quot;,&quot;max&quot;:null,&quot;min&quot;:null,&quot;nullOption&quot;:&quot;all-values&quot;,&quot;skip&quot;:false,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;appliedValues&quot;:[],&quot;fieldName&quot;:&quot;DamageRecoveryPath&quot;,&quot;filterType&quot;:&quot;categorical&quot;,&quot;isExcludeMode&quot;:false,&quot;skip&quot;:false,&quot;updateType&quot;:&quot;all&quot;,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;dataType&quot;:&quot;number&quot;,&quot;fieldName&quot;:&quot;DurationofEntireEventdays&quot;,&quot;filterType&quot;:&quot;range&quot;,&quot;max&quot;:null,&quot;min&quot;:null,&quot;nullOption&quot;:&quot;all-values&quot;,&quot;skip&quot;:false,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;appliedValues&quot;:[],&quot;fieldName&quot;:&quot;EconomicScenario&quot;,&quot;filterType&quot;:&quot;categorical&quot;,&quot;isExcludeMode&quot;:false,&quot;skip&quot;:false,&quot;updateType&quot;:&quot;all&quot;,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;dataType&quot;:&quot;number&quot;,&quot;fieldName&quot;:&quot;Event Probability&quot;,&quot;filterType&quot;:&quot;range&quot;,&quot;max&quot;:null,&quot;min&quot;:null,&quot;nullOption&quot;:&quot;all-values&quot;,&quot;skip&quot;:false,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;appliedValues&quot;:[],&quot;fieldName&quot;:&quot;Exposure Recovery Path&quot;,&quot;filterType&quot;:&quot;categorical&quot;,&quot;isExcludeMode&quot;:false,&quot;skip&quot;:false,&quot;updateType&quot;:&quot;all&quot;,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;dataType&quot;:&quot;number&quot;,&quot;fieldName&quot;:&quot;FutureEventFrequency&quot;,&quot;filterType&quot;:&quot;range&quot;,&quot;max&quot;:null,&quot;min&quot;:null,&quot;nullOption&quot;:&quot;all-values&quot;,&quot;skip&quot;:false,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;dataType&quot;:&quot;number&quot;,&quot;fieldName&quot;:&quot;HazardDim1&quot;,&quot;filterType&quot;:&quot;range&quot;,&quot;max&quot;:null,&quot;min&quot;:null,&quot;nullOption&quot;:&quot;all-values&quot;,&quot;skip&quot;:false,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;appliedValues&quot;:[],&quot;fieldName&quot;:&quot;Project Group&quot;,&quot;filterType&quot;:&quot;categorical&quot;,&quot;isExcludeMode&quot;:false,&quot;skip&quot;:false,&quot;updateType&quot;:&quot;all&quot;,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;dataType&quot;:&quot;number&quot;,&quot;fieldName&quot;:&quot;ProjectCosts_Discounted&quot;,&quot;filterType&quot;:&quot;range&quot;,&quot;max&quot;:null,&quot;min&quot;:null,&quot;nullOption&quot;:&quot;all-values&quot;,&quot;skip&quot;:false,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;appliedValues&quot;:[],&quot;fieldName&quot;:&quot;Resiliency Project&quot;,&quot;filterType&quot;:&quot;categorical&quot;,&quot;isExcludeMode&quot;:false,&quot;skip&quot;:false,&quot;updateType&quot;:&quot;all&quot;,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;appliedValues&quot;:[],&quot;fieldName&quot;:&quot;Asset-Project&quot;,&quot;filterType&quot;:&quot;categorical&quot;,&quot;isExcludeMode&quot;:false,&quot;skip&quot;:false,&quot;updateType&quot;:&quot;all&quot;,&quot;worksheetName&quot;:&quot;scatter plot (1v2)&quot;},{&quot;dataType&quot;:&quot;number&quot;,&quot;fieldName&quot;:&quot;TripElasticity&quot;,&quot;fil