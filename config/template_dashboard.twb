                  <formatted-text>
                    <run fontalignment='1' fontcolor='#32374b' fontname='Tableau Regular' fontsize='14' italic='true'>Top</run>
                    <run fontalignment='1' fontcolor='#32374b' fontname='Tableau Bold' fontsize='18' italic='true'>Æ </run>
                    <run bold='true' fontalignment='1' fontcolor='#32374b' fontname='Tableau Bold' fontsize='16' italic='true'><![CDATA[<[Parameters].[Asset Parameter (copy)]>]]></run>
                    <run fontalignment='1' fontcolor='#32374b' fontname='Tableau Regular' fontsize='14' italic='true'> Ranked Resilency Projects by Regret</run>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='14' italic='true'>[          ]</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
