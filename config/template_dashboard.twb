      <column caption='_NetBenefits_Discounted - pos/neg calc' datatype='integer' name='[Calculation_5956010547689893892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [BCAlevel - pos/neg (copy)_5956010547697397766], [ResiliencyProject] :&#13;&#10;&#13;&#10;IF SUM([NetBenefits_Discounted]) = 0 THEN 0&#13;&#10;&#13;&#10;ELSEIF AVG([BCAlevel - pos/neg (copy)_5956010547697397766]) = 0 THEN -COUNT([IDScenario])&#13;&#10;&#13;&#10;ELSE COUNT([IDScenario])&#13;&#10;&#13;&#10;END}' />
      </column>
      <column caption='_netben_bin size' datatype='real' name='[Calculation_628533636950040581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{(MAX([NetBenefits_Discounted]) - MIN([NetBenefits_Discounted]))} / &#13;&#10;    {3 + LOG(COUNTD([NetBenefits_Discounted]), 2) * &#13;&#10;        LOG(COUNTD([NetBenefits_Discounted]))}' />
      </column>
      <column caption='_netben_bin value' datatype='integer' name='[Calculation_628533636951265287]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([NetBenefits_Discounted] / [Calculation_628533636950040581])' />
      </column>
      <column caption='_netben bin value * size' datatype='real' name='[Calculation_628533636960083976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_628533636951265287] * [Calculation_628533636950040581]' />
      </column>
      <column caption='_BCR_dis - COV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_8187544157606592512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( STDEV([BCR_Discounted]) / AVG([BCR_Discounted]) )' />
      </column>
