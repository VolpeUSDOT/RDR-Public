      <column caption='_NetBenefits_Discounted - pos/neg' datatype='integer' datatype-customized='true' name='[BCAlevel - pos/neg (copy)_5956010547697397766]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT([NetBenefits_Discounted]&gt;0)' />
      </column>
      <column datatype='real' name='[BCR_Discounted]' role='measure' type='quantitative' />
      <column datatype='real' name='[Benefits_Discounted]' role='measure' type='quantitative' />
      <column caption='_RegretScenario_Count' datatype='integer' name='[Calculation_0535505769148420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [RegretScenario] == 1 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='_NetBenefits_Disc (norm-avg)' datatype='real' name='[Calculation_121034246486528000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF AVG([NetBenefits_Discounted]) &gt;= 1000000000 &#13;&#10;    THEN AVG([NetBenefits_Discounted]) / 1000000000&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &lt;= -1000000000 &#13;&#10;    THEN AVG([NetBenefits_Discounted]) / 1000000000&#13;&#10;&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &gt;= 1000000 &#13;&#10;    THEN AVG([NetBenefits_Discounted]) / 1000000&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &lt;= -1000000 &#13;&#10;    THEN AVG([NetBenefits_Discounted]) / 1000000&#13;&#10;&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &gt;= 1000 &#13;&#10;    THEN AVG([NetBenefits_Discounted]) / 1000&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &lt;= -1000 &#13;&#10;    THEN AVG([NetBenefits_Discounted]) / 1000&#13;&#10;&#13;&#10;ELSE AVG([NetBenefits_Discounted])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='_NetBenefits_Disc (norm text-avg)' datatype='string' name='[Calculation_121034246487384065]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([NetBenefits_Discounted]) &gt;= 1000000000 THEN &apos;B&apos;&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &lt;= -1000000000 THEN &apos;B&apos;&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &gt;= 1000000 THEN &apos;M&apos;&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &lt;= -1000000 THEN &apos;M&apos;&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &gt;= 1000 THEN &apos;K&apos;&#13;&#10;ELSEIF AVG([NetBenefits_Discounted]) &lt;= -1000 THEN &apos;K&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='_NetBenefits_Disc - COV' datatype='real' name='[Calculation_1431300292636811264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ( STDEV([NetBenefits_Discounted]) / AVG([NetBenefits_Discounted]) ) = 0 &#13;&#10;    THEN STDEV([NetBenefits_Discounted])&#13;&#10;ELSE ( STDEV([NetBenefits_Discounted]) / AVG([NetBenefits_Discounted]) )&#13;&#10;END' />
      </column>
      <column caption='_Resiliency Project Param - calc' datatype='boolean' name='[Calculation_1655354347713019905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[ResiliencyProject] = [Parameters].[Resiliency Project Parameter]' />
      </column>
      <column caption='_Parameter 1 Calc' datatype='real' name='[Calculation_1729663733867085827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Asset Damagelevels Parameter]&#13;&#10;&#13;&#10;WHEN &quot;HazardDim1&quot; THEN [HazardDim1]&#13;&#10;WHEN &quot;Benefits_Discounted&quot; THEN [Benefits_Discounted]&#13;&#10;WHEN &quot;NetBenefits_Discounted&quot; THEN [NetBenefits_Discounted]&#13;&#10;WHEN &quot;TotalNetBenefits_Discounted&quot; THEN [TotalNetBenefits_Discounted]&#13;&#10;WHEN &quot;DamBenefits_Discounted&quot; THEN [DamBenefits_Discounted]&#13;&#10;WHEN &quot;RepairCleanupCostSavings_Discounted&quot; THEN [RepairCleanupCostSavings_Discounted]&#13;&#10;WHEN &quot;ExpBenefits_Discounted&quot; THEN [ExpBenefits_Discounted]&#13;&#10;WHEN &quot;BCR_Discounted&quot; THEN [BCR_Discounted]&#13;&#10;WHEN &quot;TotalMaintenanceCosts_Discounted&quot; THEN [TotalMaintenanceCosts_Discounted]&#13;&#10;WHEN &quot;TotalResidual_Discounted&quot; THEN [TotalResidual_Discounted]&#13;&#10;WHEN &quot;RegretAll&quot; THEN [RegretAll]&#13;&#10;WHEN &quot;RegretAsset&quot; THEN [RegretAsset]&#13;&#10;WHEN &quot;RegretScenario&quot; THEN [RegretScenario]&#13;&#10;WHEN &quot;DamageDuration&quot; THEN [DamageDuration]&#13;&#10;WHEN &quot;DurationofEntireEventdays&quot; THEN [DurationofEntireEventdays]&#13;&#10;//WHEN &quot;EconomicScenario&quot; THEN [EconomicScenario]&#13;&#10;WHEN &quot;FutureEventFrequency&quot; THEN [FutureEventFrequency]&#13;&#10;WHEN &quot;initEmissions_Discounted&quot; THEN [initEmissions_Discounted]&#13;&#10;WHEN &quot;initSafety_Discounted&quot; THEN [initSafety_Discounted]&#13;&#10;WHEN &quot;initTripsvsBase&quot; THEN [initTripsvsBase]&#13;&#10;WHEN &quot;initTripsvsBase_dollar&quot; THEN [initTripsvsBase_dollar]&#13;&#10;WHEN &quot;initPHTvsBase&quot; THEN [initPHTvsBase]&#13;&#10;WHEN &quot;initPHTvsBase_dollar&quot; THEN [initPHTvsBase_dollar]&#13;&#10;WHEN &quot;initVMTvsBase&quot; THEN [initVMTvsBase]&#13;&#10;WHEN &quot;initVMTvsBase_dollar&quot; THEN [initVMTvsBase_dollar]&#13;&#10;WHEN &quot;expEmissions_Discounted&quot; THEN [expEmissions_Discounted]&#13;&#10;WHEN &quot;expSafety_Discounted&quot; THEN [expSafety_Discounted]&#13;&#10;WHEN &quot;expTripsvsBase&quot; THEN [expTripsvsBase]&#13;&#10;WHEN &quot;expTripsvsBase_dollar&quot; THEN [expTripsvsBase_dollar]&#13;&#10;WHEN &quot;expPHTvsBase&quot; THEN [expPHTvsBase]&#13;&#10;WHEN &quot;expPHTvsBase_dollar&quot; THEN [expPHTvsBase_dollar]&#13;&#10;WHEN &quot;expVMTvsBase&quot; THEN [expVMTvsBase]&#13;&#10;WHEN &quot;expVMTvsBase_dollar&quot; THEN [expVMTvsBase_dollar]&#13;&#10;WHEN &quot;damEmissions_Discounted&quot; THEN [damEmissions_Discounted]&#13;&#10;WHEN &quot;damSafety_Discounted&quot; THEN [damSafety_Discounted]&#13;&#10;WHEN &quot;damTripsvsBase&quot; THEN [damTripsvsBase]&#13;&#10;WHEN &quot;damTripsvsBase_dollar&quot; THEN [damTripsvsBase_dollar]&#13;&#10;WHEN &quot;damPHTvsBase&quot; THEN [damPHTvsBase]&#13;&#10;WHEN &quot;damPHTvsBase_dollar&quot; THEN [damPHTvsBase_dollar]&#13;&#10;WHEN &quot;damVMTvsBase&quot; THEN [damVMTvsBase]&#13;&#10;WHEN &quot;damVMTvsBase_dollar&quot; THEN [damVMTvsBase_dollar]&#13;&#10;WHEN &quot;AssetDamagelevels&quot; THEN [AssetDamagelevels]&#13;&#10;WHEN &quot;AssetDamagevsBase&quot; THEN [AssetDamagevsBase]&#13;&#10;WHEN &quot;RepairCleanupCosts&quot; THEN [RepairCleanupCosts]&#13;&#10;WHEN &quot;RepairCleanupCostSavings&quot; THEN [RepairCleanupCostSavings]&#13;&#10;WHEN &quot;RepairCostSavings&quot; THEN [RepairCostSavings]&#13;&#10;&#13;&#10;WHEN &quot;initNoise_Discounted&quot; THEN [initNoise_Discounted]&#13;&#10;WHEN &quot;damNoise_Discounted&quot; THEN [damNoise_Discounted]&#13;&#10;WHEN &quot;expNoise_Discounted&quot; THEN [expNoise_Discounted]&#13;&#10;&#13;&#10;END' />
      </column>
