                    <run fontalignment='1' fontcolor='#32374b' fontname='Tableau Regular' fontsize='14' italic='true'> Ranked Asset-Projects by </run>
                    <run bold='true' fontalignment='1' fontcolor='#32374b' fontname='Tableau Regular' fontsize='16' italic='true'><![CDATA[<[Parameters].[Parameter 6 Selector (copy)_4665729230322843654]>]]></run>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='14' italic='true'>[          ]</run>
                  </formatted-text>
                  <zone-style>
