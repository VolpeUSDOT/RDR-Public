                  </zone-style>
                </zone>
                <zone fixed-size='64' h='6400' id='175' is-fixed='true' is-scaled='1' param='C:/RDR/HRTPO_LRTP_Aug19/Image/images.png' type-v2='bitmap' w='5778' x='94222' y='0'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
